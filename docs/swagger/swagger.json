{
    "swagger": "2.0",
    "info": {
        "description": "Audit Log Service — the platform compliance system-of-record (LLD §1). Append-only, tenant-scoped audit trail.\n\n**Public** `/api/v1/audit/*` (AL-1..AL-4): tenant_admin / tenant_owner only; RLS-scoped to x-tenant-id; plan-gated query window.\n**Internal** `/api/v1/internal/*` (AL-5..AL-7): mesh-only, iam-system peers; direct-write ingest requires `Idempotency-Key`.",
        "title": "IAM Audit Log API",
        "contact": {
            "name": "BCBP Solutions",
            "email": "indhu@bcbpsolutions.com"
        },
        "license": {
            "name": "Proprietary"
        },
        "version": "0.1"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/audit/events": {
            "get": {
                "security": [
                    {
                        "TenantRoles": []
                    },
                    {
                        "TenantID": []
                    },
                    {
                        "UserID": []
                    }
                ],
                "description": "Keyset-paginated (occurred_at DESC, id DESC) search within the plan window (AL-INV-8). A range older than the window is clamped (window_clamped=true, effective_from). Archived months are read from S3 when the estimate is within ARCHIVE_SYNC_MAX_ROWS / ARCHIVE_SYNC_MAX_BYTES; otherwise an export is created and 202 returned (decision D-10).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Audit"
                ],
                "summary": "Search the tenant's audit trail (AL-1)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "occurred_at lower bound (RFC 3339)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "occurred_at upper bound (RFC 3339; default now)",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "entry type (repeatable)",
                        "name": "entry_type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "actor UUID",
                        "name": "actor_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "user | service_account | iam_system | anonymous",
                        "name": "actor_type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "target type",
                        "name": "target_type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "target id (requires target_type)",
                        "name": "target_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "source service",
                        "name": "source_service",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "compliance_7y | security_3y | access_90d",
                        "name": "retention_tier",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "page size (default 100, max 1000)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "opaque keyset cursor",
                        "name": "cursor",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.EventsResponse"
                        }
                    },
                    "202": {
                        "description": "large archived range deferred to an export",
                        "schema": {
                            "$ref": "#/definitions/http.ExportAcceptedResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "missing_identity_headers",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "insufficient_permissions",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "rate_limited (deferred export)",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "dependency_unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/audit/events/{id}": {
            "get": {
                "security": [
                    {
                        "TenantRoles": []
                    },
                    {
                        "TenantID": []
                    },
                    {
                        "UserID": []
                    }
                ],
                "description": "Within the caller's tenant (RLS) and plan window. An entry whose month was archived is read from the tenant's archive object whose id range holds it (BUILD_PLAN gap 32).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Audit"
                ],
                "summary": "Read one audit entry (AL-2)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "entry id (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.EventDTO"
                        }
                    },
                    "400": {
                        "description": "invalid_request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "insufficient_permissions",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "audit_entry_not_found",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "dependency_unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/audit/exports": {
            "post": {
                "security": [
                    {
                        "TenantRoles": []
                    },
                    {
                        "TenantID": []
                    },
                    {
                        "UserID": []
                    }
                ],
                "description": "Body is the AL-1 filter (all optional), clamped to the plan window. Creates a pending job; poll AL-4. Rate-limited per tenant (§10.5).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Audit"
                ],
                "summary": "Request an asynchronous export (AL-3)",
                "parameters": [
                    {
                        "description": "filter",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/http.ExportFilterRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/http.ExportAcceptedResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "insufficient_permissions",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "rate_limited",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "dependency_unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/audit/exports/{id}": {
            "get": {
                "security": [
                    {
                        "TenantRoles": []
                    },
                    {
                        "TenantID": []
                    },
                    {
                        "UserID": []
                    }
                ],
                "description": "When ready, download_url is a freshly presigned short-lived URL (EXPORT_DOWNLOAD_URL_TTL) re-issued on every poll until expires_at (7 days, decision D-11).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Audit"
                ],
                "summary": "Poll an export job (AL-4)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "export id (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ExportStatusResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "insufficient_permissions",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "export_not_found",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "dependency_unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/internal/audit-entries": {
            "post": {
                "security": [
                    {
                        "TenantRoles": []
                    },
                    {
                        "TenantID": []
                    },
                    {
                        "UserID": []
                    },
                    {
                        "IdempotencyKey": []
                    }
                ],
                "description": "Mesh-only ingest for non-bus audit entries (LLD §5.4, AL-D1). The Idempotency-Key header becomes the entry's source_event_id; a retry with the same key returns 200 with the already-persisted entry. retention_tier is derived from entry_type — a caller-supplied value is ignored (AL-INV-11). Only direct-write entry types are accepted (decision D-6).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Ingest"
                ],
                "summary": "Direct-write one audit entry (AL-5)",
                "parameters": [
                    {
                        "description": "Audit entry",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.DirectWriteRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "idempotent replay",
                        "schema": {
                            "$ref": "#/definitions/http.EntryResponse"
                        }
                    },
                    "201": {
                        "description": "created",
                        "schema": {
                            "$ref": "#/definitions/http.EntryResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "forbidden_peer",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "unknown_entry_type | invalid_actor | metadata_too_large",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "dependency_unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/internal/audit-entries:batch": {
            "post": {
                "security": [
                    {
                        "TenantRoles": []
                    },
                    {
                        "TenantID": []
                    },
                    {
                        "UserID": []
                    },
                    {
                        "IdempotencyKey": []
                    }
                ],
                "description": "Up to MAX_INGEST_BATCH entries, each with its own idempotency_key (decision D-4). Always 207: per-index status 201 (created), 200 (replay) or the §17 error; a bad entry never rejects the batch. Rate-limited per tenant (429, §10.5).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Ingest"
                ],
                "summary": "Direct-write a batch of audit entries (AL-6)",
                "parameters": [
                    {
                        "description": "Entries",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.BatchRequest"
                        }
                    }
                ],
                "responses": {
                    "207": {
                        "description": "per-entry results",
                        "schema": {
                            "$ref": "#/definitions/http.BatchResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "forbidden_peer",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "batch_too_large",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "rate_limited",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/internal/audit/events": {
            "get": {
                "security": [
                    {
                        "TenantRoles": []
                    },
                    {
                        "TenantID": []
                    },
                    {
                        "UserID": []
                    }
                ],
                "description": "For compliance/verification service callers (iam-system role). tenant_id is required and bound to app.tenant_id, so RLS still applies and there is no cross-tenant read. There is no plan-window clamp (§5.4); window_clamped is always false and effective_from is the lower bound applied. The filter, limit and cursor contract is the same as AL-1. An archived range over ARCHIVE_SYNC_MAX_ROWS / ARCHIVE_SYNC_MAX_BYTES returns 422 range_too_large; narrow from/to (decision D-14).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Internal"
                ],
                "summary": "Mesh-only provenance read (AL-7)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "tenant whose trail is read (UUID)",
                        "name": "tenant_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "occurred_at lower bound (RFC 3339; default unbounded)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "occurred_at upper bound (RFC 3339; default now)",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "entry type (repeatable)",
                        "name": "entry_type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "actor UUID",
                        "name": "actor_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "user | service_account | iam_system | anonymous",
                        "name": "actor_type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "target type",
                        "name": "target_type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "target id (requires target_type)",
                        "name": "target_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "source service",
                        "name": "source_service",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "compliance_7y | security_3y | access_90d",
                        "name": "retention_tier",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "page size (default 100, max 1000)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "opaque keyset cursor",
                        "name": "cursor",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.EventsResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_request",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "missing_identity_headers",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "forbidden_peer",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "range_too_large",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "dependency_unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "http.ActorDTO": {
            "type": "object",
            "properties": {
                "display": {
                    "type": "string",
                    "example": "asha@acme.example"
                },
                "id": {
                    "type": "string",
                    "example": "7f3c2d1e-9a8b-4c5d-8e7f-0a1b2c3d4e5f"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "user",
                        "service_account",
                        "iam_system",
                        "anonymous"
                    ],
                    "example": "user"
                }
            }
        },
        "http.BatchEntryRequest": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string",
                    "example": "update"
                },
                "actor": {
                    "$ref": "#/definitions/http.ActorDTO"
                },
                "entry_type": {
                    "type": "string",
                    "example": "config.tenant_setting.changed"
                },
                "idempotency_key": {
                    "type": "string",
                    "example": "4b1f0f8e-2c1d-5e3a-9f0b-7c6d5e4f3a21"
                },
                "ip_address": {
                    "type": "string",
                    "example": "203.0.113.7"
                },
                "metadata": {
                    "type": "object"
                },
                "occurred_at": {
                    "type": "string",
                    "example": "2026-03-14T09:12:04Z"
                },
                "source_event_type": {
                    "type": "string",
                    "example": "TenantSettingChanged"
                },
                "source_service": {
                    "type": "string",
                    "example": "iam-org-membership"
                },
                "target": {
                    "$ref": "#/definitions/http.TargetDTO"
                },
                "tenant_id": {
                    "type": "string",
                    "example": "00000000-0000-0000-0000-0000000000b1"
                },
                "trace_id": {
                    "type": "string"
                },
                "user_agent": {
                    "type": "string"
                }
            }
        },
        "http.BatchRequest": {
            "type": "object",
            "properties": {
                "entries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/http.BatchEntryRequest"
                    }
                }
            }
        },
        "http.BatchResponse": {
            "type": "object",
            "properties": {
                "results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/http.BatchResultItem"
                    }
                }
            }
        },
        "http.BatchResultItem": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "unknown_entry_type"
                },
                "id": {
                    "type": "string"
                },
                "index": {
                    "type": "integer"
                },
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "integer",
                    "example": 201
                }
            }
        },
        "http.DirectWriteRequest": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string",
                    "example": "update"
                },
                "actor": {
                    "$ref": "#/definitions/http.ActorDTO"
                },
                "entry_type": {
                    "type": "string",
                    "example": "config.tenant_setting.changed"
                },
                "ip_address": {
                    "type": "string",
                    "example": "203.0.113.7"
                },
                "metadata": {
                    "type": "object"
                },
                "occurred_at": {
                    "type": "string",
                    "example": "2026-03-14T09:12:04Z"
                },
                "source_event_type": {
                    "type": "string",
                    "example": "TenantSettingChanged"
                },
                "source_service": {
                    "type": "string",
                    "example": "iam-org-membership"
                },
                "target": {
                    "$ref": "#/definitions/http.TargetDTO"
                },
                "tenant_id": {
                    "type": "string",
                    "example": "00000000-0000-0000-0000-0000000000b1"
                },
                "trace_id": {
                    "type": "string"
                },
                "user_agent": {
                    "type": "string"
                }
            }
        },
        "http.EntryResponse": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string"
                },
                "actor": {
                    "$ref": "#/definitions/http.ActorDTO"
                },
                "entry_type": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "ingest_mode": {
                    "type": "string"
                },
                "ip_address": {
                    "type": "string"
                },
                "metadata": {
                    "type": "object"
                },
                "occurred_at": {
                    "type": "string"
                },
                "recorded_at": {
                    "type": "string"
                },
                "retention_tier": {
                    "type": "string"
                },
                "source_event_id": {
                    "type": "string"
                },
                "source_event_type": {
                    "type": "string"
                },
                "source_service": {
                    "type": "string"
                },
                "source_topic": {
                    "type": "string"
                },
                "target": {
                    "$ref": "#/definitions/http.TargetDTO"
                },
                "tenant_id": {
                    "type": "string"
                },
                "trace_id": {
                    "type": "string"
                },
                "user_agent": {
                    "type": "string"
                }
            }
        },
        "http.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "details": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "error": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "request_id": {
                    "type": "string"
                },
                "status": {
                    "type": "integer"
                },
                "trace_id": {
                    "type": "string"
                }
            }
        },
        "http.EventDTO": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string",
                    "example": "granted"
                },
                "actor": {
                    "$ref": "#/definitions/http.ActorDTO"
                },
                "entry_type": {
                    "type": "string",
                    "example": "membership.department.granted"
                },
                "id": {
                    "type": "string"
                },
                "ip_address": {
                    "type": "string"
                },
                "metadata": {
                    "type": "object"
                },
                "occurred_at": {
                    "type": "string"
                },
                "retention_tier": {
                    "type": "string",
                    "example": "compliance_7y"
                },
                "source_event_type": {
                    "type": "string"
                },
                "source_service": {
                    "type": "string",
                    "example": "iam-org-membership"
                },
                "target": {
                    "$ref": "#/definitions/http.TargetDTO"
