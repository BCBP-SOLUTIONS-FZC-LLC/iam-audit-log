# Trivy ignore list — every entry needs a reason and an expiry (exp:), so a
# suppression can never outlive the condition that justified it. After the
# expiry date the finding fails the ci.yml gate again.

# DLA-4792-1 — tzdata 2026b → 2026c in gcr.io/distroless/static-debian12:nonroot.
# A timezone-database refresh, not a security flaw (Trivy: UNKNOWN). Not
# exploitable here: the service never loads a zone (no time.LoadLocation, no
# time/tzdata; all timestamps are UTC). Blocked upstream: pinned distroless
# digest (sha256:afa5c872…) still ships tzdata 2026b. Remove once distroless
# ships 2026c and re-pin.
DLA-4792-1 exp:2027-01-31

# DLA-4867-1 — tzdata 2026b → 2026f in gcr.io/distroless/static-debian12:nonroot.
# Same package and situation as DLA-4792-1 and DLA-4854-1: a timezone-database
# refresh (Trivy: UNKNOWN), not a security flaw. Not exploitable here: the
# service never loads a zone (no time.LoadLocation, no time/tzdata, no
# time.Local use; all timestamps are UTC). Blocked upstream: pinned distroless
# digest (sha256:afa5c872…) still ships tzdata 2026b. Remove once distroless
# ships tzdata >= 2026f and re-pin.
DLA-4867-1 exp:2027-01-31

# DLA-4845-1 — ca-certificates 20250419~deb12u1 → deb12u2 in
# gcr.io/distroless/static-debian12:nonroot (removes the distrusted Comodo
# "AAA Certificate Services" and "emSign ECC Root CA - G3" roots). Not
# exploitable here: the Dockerfile copies the builder's patched deb12u2 bundle
# over distroless's /etc/ssl/certs/ca-certificates.crt, which is the file the
# Go binaries trust; Trivy still reports it only because it reads distroless's
# dpkg metadata. Blocked upstream: on 2026-10-21 the pinned digest was still
# the latest :nonroot. Remove this entry, the Dockerfile COPY, and re-pin once
# distroless ships deb12u2. Same fix as iam-realm-provisioner commit 6bd23df.
DLA-4845-1 exp:2026-11-21

# DLA-4854-1: tzdata 2026b-0+deb12u1 → 2026e-0+deb12u1, a timezone-database
# refresh (Trivy: UNKNOWN; the CI gate fails on UNKNOWN). Same package and
# situation as DLA-4792-1 above.
# Not exploitable here: the service never loads a zone (no time.LoadLocation, no
# time/tzdata, no time.Local use; all timestamps are UTC).
# Blocked upstream: on 2026-10-26 the newest gcr.io/distroless/static-debian12
# :nonroot digest (sha256:afa5c872…) still ships tzdata 2026b. Remove this
# entry and re-pin once distroless ships tzdata >= 2026e.
DLA-4854-1 exp:2026-11-30
