# Local development defaults for `make run` (copy to .env via `make setup`).
# Variable names/defaults follow LLD §12.

APP_ENV=dev
SERVICE_NAME=iam-audit-log
APP_PORT=8080
METRICS_PORT=9090

# ── audit DB (LLD §3.3.2, §4.3) ───────────────────────────────────────────
# cmd/server: audit_app (INSERT+SELECT only, RLS-bound). In dev a superuser
# DSN is tolerated (role check logs a warning).
DATABASE_URL=postgres://postgres:postgres@localhost:5548/audit?sslmode=disable
DB_APP_ROLE=audit_app
# Migrations run as audit_migrator, direct to Postgres (not PgBouncer).
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5548/audit?sslmode=disable
# cmd/reconciler only: audit_reconciler (BYPASSRLS).
RECONCILER_DATABASE_URL=postgres://postgres:postgres@localhost:5548/audit?sslmode=disable
DB_RECONCILER_ROLE=audit_reconciler
PG_BOUNCER_MODE=false
PG_SSLMODE=disable

# ── AWS (floci) ───────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4573
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
GLUE_REGISTRY_REGION=ap-south-1

# ── Inbound queues (LLD §7.1) — printed by scripts/init-floci.sh ─────────
AUTH_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/auth-audit-q
USER_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/user-audit-q
MEMBERSHIP_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/membership-audit-q
TENANT_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/tenant-audit-q
DELEGATION_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/delegation-audit-q
SERVICEACCOUNT_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/serviceaccount-audit-q
TENDER_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/tender-audit-q
BILLING_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/billing-audit-q
USAGE_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/usage-audit-q
WF_WORKFLOW_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/wf-workflow-audit-q
WF_TEMPLATE_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/wf-template-audit-q
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT=30s

# ── Archive (LLD §15.4) ───────────────────────────────────────────────────
AUDIT_ARCHIVE_BUCKET=iam-audit-archive
AUDIT_ARCHIVE_KMS_KEY=alias/iam-audit-archive
AUDIT_ARCHIVE_OBJECT_LOCK_MODE=COMPLIANCE
AUDIT_HOT_WINDOW_DAYS=90
AUDIT_PRECREATE_MONTHS=3
AUDIT_WRITABLE_TRAILING_MONTHS=3

# ── Query / ingest (LLD §5.4, §12) ────────────────────────────────────────
AUDIT_DEFAULT_QUERY_WINDOW_DAYS=365
MAX_INGEST_BATCH=500
MAX_METADATA_BYTES=8192
EXPORT_SIGNED_URL_TTL=168h
# AL-6 per-tenant rate limit (LLD §10.5; decision D-5)
INGEST_BATCH_RATE_LIMIT_RPS=10
INGEST_BATCH_RATE_LIMIT_BURST=20

# ── CAT-I2 plans poller (AL-D15) ──────────────────────────────────────────
CATALOG_BASE_URL=http://localhost:8085
CATALOG_PLANS_POLL_INTERVAL=600s
CATALOG_PLANS_POLL_TIMEOUT=3s

# ── Reconciler ────────────────────────────────────────────────────────────
PROCESSED_EVENTS_TTL_DAYS=8
RECONCILER_TIMEOUT=30m
