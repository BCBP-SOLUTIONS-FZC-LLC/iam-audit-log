# ─────────────────────────────────────────────────────────────────────────
# iam-audit-log — local dev environment
# ─────────────────────────────────────────────────────────────────────────
# Copy to .env and adjust. `make setup` copies this file if .env is absent.
# Variable names/defaults follow LLD §12 (internal/config/config.go).
# Library-owned names (PG_*, SQS_*, OTEL_*) are read by platform-pgcommon,
# platform-events and platform-gincommon, never by this repo (gaps 43–45).
# Private modules require an SSH key registered with the BCBP org.
GOPRIVATE=github.com/BCBP-SOLUTIONS-FZC-LLC/*
GONOSUMDB=github.com/BCBP-SOLUTIONS-FZC-LLC/*

# ── Application ──────────────────────────────────────────────────────────
# APP_NAME is the platform libraries' fallback name (gincommon uses it when
# OTEL_SERVICE_NAME is unset); SERVICE_NAME is this service's own — logs,
# gincommon middleware and the "-reconciler" suffix for cmd/reconciler.
APP_NAME=iam-audit-log
SERVICE_NAME=iam-audit-log
APP_ENV=dev
APP_PORT=8080
# /metrics is served on its own dedicated port/listener, separate from
# APP_PORT — see cmd/server/main.go.
METRICS_PORT=9090

# ── PostgreSQL (LLD §3.3.2, §4.3) ────────────────────────────────────────
# make docker-up exposes Postgres on 5548 (siblings hold 5433/5434 and
# 5533/5534). No PgBouncer container locally: every pool connects direct.
# Container-internal port stays 5432; only the host publish differs.
#
# One DSN per role, one role per composition root (implementation rule 5).
# In dev all three point at the local superuser — the app-role check logs a
# warning instead of failing (appRoleOK).
#
# cmd/server — audit_app (INSERT+SELECT only, RLS-bound; AL-INV-1/3).
DATABASE_URL=postgres://postgres:postgres@localhost:5548/audit?sslmode=disable
DB_APP_ROLE=audit_app
# cmd/server startup migrations — audit_migrator, direct to Postgres (never
# through PgBouncer; LLD §4.4). The server self-migrates at startup.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5548/audit?sslmode=disable
# cmd/reconciler only — audit_reconciler (BYPASSRLS). Never set in the
# server's Secret, and DATABASE_URL never in the reconciler's.
RECONCILER_DATABASE_URL=postgres://postgres:postgres@localhost:5548/audit?sslmode=disable
DB_RECONCILER_ROLE=audit_reconciler

# Pool tuning — read by pgcommon.ConfigFromEnv (the DSNs above take precedence
# over PG_HOST/PG_PORT/PG_USER/PG_PASSWORD/PG_DBNAME, so those are omitted).
PG_SSLMODE=disable
PG_MAX_CONNS=20
PG_MIN_CONNS=0
PG_SLOW_QUERY_THRESHOLD=200ms
# Ignored for both pools: AppPoolConfig/ReconcilerPoolConfig FORCE PgBouncer
# mode on, because only that path binds app.tenant_id transaction-locally
# (session-level GUCs leak across checkouts — AL-INV-3, gap 28). Kept so the
# value matches the Helm chart.
PG_BOUNCER_MODE=true

# ── AWS SQS / S3 / Glue (floci in dev) ───────────────────────────────────
# `make docker-up` starts floci on host port 4573; the init hook
# (scripts/init-floci.sh) provisions the full topology: 11 topics, 11 queues
# + DLQs, subscriptions, the archive bucket and the Glue registries.
# No SNS topic ARNs: this service publishes nothing (AL-INV-10) — no
# publisher, no outbox.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4573

# Inbound queues (LLD §7.1) — one per audited topic, catch-all. Printed by
# scripts/init-floci.sh.
AUTH_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/auth-audit-q
USER_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/user-audit-q
MEMBERSHIP_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/membership-audit-q
TENANT_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/tenant-audit-q
DELEGATION_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/delegation-audit-q
SERVICEACCOUNT_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/serviceaccount-audit-q
TENDER_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/tender-audit-q
BILLING_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/billing-audit-q
USAGE_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/usage-audit-q
WF_WORKFLOW_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/wf-workflow-audit-q
WF_TEMPLATE_AUDIT_QUEUE_URL=http://localhost:4573/000000000000/wf-template-audit-q

# SQS consumer settings — read by platform-events (config.LoadSQS), not by
# this service (gap 45). SQS_MAX_RECEIVE_COUNT must equal the queues'
# redrive maxReceiveCount: the fleet counts a DLQ move at receive
# count − 1 (DeadLetterObserveAt).
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT=30s
SQS_CONCURRENCY=4
# SQS_MAX_MESSAGES=10          # library default
# SQS_WAIT_SECONDS=20          # library default (long polling)

# Glue Schema Registry — consume side only. Messages are decoded by the
# schema version id they carry, so no registry names are configured here;
# the producers own and register every schema (no schema-gov targets —
# there are no produced schemas to govern).
GLUE_REGISTRY_REGION=ap-south-1

# ── OpenTelemetry (platform-gincommon) ───────────────────────────────────
# The trace resource service.name — falls back to APP_NAME when unset.
OTEL_SERVICE_NAME=iam-audit-log
# gincommon always installs an OTLP/gRPC exporter; an empty endpoint means
# localhost:4317 (it does not honour OTEL_TRACES_EXPORTER=none). The gRPC
# client connects lazily, so no collector locally is harmless — spans still
# exist in memory and trace_id in logs/error bodies keeps working.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
# Sampling: 1.0 when APP_ENV=dev, 0.1 otherwise. Override (0–1) here.
# OTEL_TRACES_SAMPLER_RATIO=1.0

# ── Archive (LLD §15.4) ──────────────────────────────────────────────────
# SSE-KMS + Object Lock COMPLIANCE; per tier/tenant/month keys (D-10).
AUDIT_ARCHIVE_BUCKET=iam-audit-archive
AUDIT_ARCHIVE_KMS_KEY=alias/iam-audit-archive
AUDIT_ARCHIVE_OBJECT_LOCK_MODE=COMPLIANCE
AUDIT_HOT_WINDOW_DAYS=90
AUDIT_PRECREATE_MONTHS=3
AUDIT_WRITABLE_TRAILING_MONTHS=3

# ── Query / ingest (LLD §5.4, §12) ───────────────────────────────────────
# Fallback query window when a plan is unknown (D-13).
AUDIT_DEFAULT_QUERY_WINDOW_DAYS=365
MAX_INGEST_BATCH=500
MAX_METADATA_BYTES=8192
EXPORT_SIGNED_URL_TTL=168h
# AL-6 per-tenant rate limit (LLD §10.5; decision D-5).
INGEST_BATCH_RATE_LIMIT_RPS=10
INGEST_BATCH_RATE_LIMIT_BURST=20
# Archived AL-1 reads above either bound become an export → 202 (D-10).
ARCHIVE_SYNC_MAX_ROWS=10000
ARCHIVE_SYNC_MAX_BYTES=52428800

# ── Export worker (AL-3/AL-4; decisions D-2, D-11; LLD §10.5) ─────────────
# A fresh presigned URL is issued on every AL-4 poll (D-11).
EXPORT_DOWNLOAD_URL_TTL=15m
EXPORT_RATE_LIMIT_PER_MINUTE=10
EXPORT_RATE_LIMIT_BURST=5
EXPORT_POLL_INTERVAL=5s
EXPORT_JOB_LEASE=15m
# EXPORT_WORK_DIR=             # temp dir for export assembly ("" → os.TempDir())

# ── Ops gauges (cmd/server; LLD §11; decision D-21) ──────────────────────
OPS_STATS_INTERVAL=60s
OPS_ARCHIVE_STALL_GRACE=48h
OPS_REDACTION_PENDING_AGE=15m

# ── Outbound service clients (LLD §18) ───────────────────────────────────
# Catalog CAT-I2 plans poller (AL-D15). Stale-if-error: a failure keeps the
# last good plan map; before the first success, callers fall back per D-13
# — so the server runs locally with no Catalog at all.
# Side-by-side port convention: iam-catalog-admin runs on 8085 locally.
CATALOG_BASE_URL=http://localhost:8085
CATALOG_PLANS_POLL_INTERVAL=600s
# Must be < CATALOG_PLANS_POLL_INTERVAL (config validation).
CATALOG_PLANS_POLL_TIMEOUT=3s

# ── Reconciler (cmd/reconciler --job=<name>) ─────────────────────────────
# `make run-reconciler JOB=<name>`: reconcile | redaction-retry |
# redaction-sweep | processed-events-prune. RECONCILER_JOB is the env
# alternative to --job.
# RECONCILER_JOB=reconcile
RECONCILER_TIMEOUT=30m
# processed_events retention (PE-1 strictly > 7-day SQS lifetime, IDEMP-4).
PROCESSED_EVENTS_TTL_DAYS=8
PROCESSED_EVENTS_PRUNE_BATCH=10000
# redaction-retry job (LLD §8.7, RB-7).
REDACTION_RETRY_MIN_AGE=5m
REDACTION_RETRY_BATCH=500
# redaction-sweep job — daily re-check of recently erased subjects (D-18).
REDACTION_SWEEP_WINDOW=2160h
# archival (LLD §8.5, §15.4).
ARCHIVE_PART_MAX_ROWS=50000
# ARCHIVE_WORK_DIR=            # temp dir for archive parts ("" → os.TempDir())

# ── Docs surface (optional) ──────────────────────────────────────────────
# /asyncapi + /asyncapi.yaml are served outside production; in production
# only with DOCS_ENABLED=true, guarded by DOCS_AUTH_TOKEN.
DOCS_ENABLED=false
DOCS_AUTH_TOKEN=
