{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeAuditQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": [
        "arn:aws:sqs:ap-south-1:ACCOUNT_ID:auth-audit-q",
        "arn:aws:sqs:ap-south-1:ACCOUNT_ID:user-audit-q",
        "arn:aws:sqs:ap-south-1:ACCOUNT_ID:membership-audit-q",
        "arn:aws:sqs:ap-south-1:ACCOUNT_ID:tenant-audit-q",
        "arn:aws:sqs:ap-south-1:ACCOUNT_ID:delegation-audit-q",
        "arn:aws:sqs:ap-south-1:ACCOUNT_ID:serviceaccount-audit-q",
        "arn:aws:sqs:ap-south-1:ACCOUNT_ID:tender-audit-q",
        "arn:aws:sqs:ap-south-1:ACCOUNT_ID:billing-audit-q",
        "arn:aws:sqs:ap-south-1:ACCOUNT_ID:usage-audit-q",
        "arn:aws:sqs:ap-south-1:ACCOUNT_ID:wf-workflow-audit-q",
        "arn:aws:sqs:ap-south-1:ACCOUNT_ID:wf-template-audit-q"
      ]
    },
    {
      "Sid": "ReadDLQDepthForAlerting",
      "Effect": "Allow",
      "Action": ["sqs:GetQueueAttributes"],
      "Resource": ["arn:aws:sqs:ap-south-1:ACCOUNT_ID:*-audit-q-dlq"]
    },
    {
      "Sid": "GlueSchemaRegistryReadOnly",
      "Effect": "Allow",
      "Action": ["glue:GetSchemaVersion", "glue:GetSchemaByDefinition"],
      "Resource": [
        "arn:aws:glue:ap-south-1:ACCOUNT_ID:registry/*",
        "arn:aws:glue:ap-south-1:ACCOUNT_ID:schema/*"
      ]
    },
    {
      "Sid": "ArchiveAndExportObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:PutObjectRetention",
        "s3:GetObjectRetention",
        "s3:GetObjectAttributes"
      ],
      "Resource": ["arn:aws:s3:::iam-audit-archive/*"]
    },
    {
      "Sid": "ArchiveBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketObjectLockConfiguration"],
      "Resource": ["arn:aws:s3:::iam-audit-archive"]
    },
    {
      "Sid": "ArchiveKMS",
      "Effect": "Allow",
      "Action": ["kms:GenerateDataKey", "kms:Decrypt", "kms:DescribeKey"],
      "Resource": ["arn:aws:kms:ap-south-1:ACCOUNT_ID:alias/iam-audit-archive"]
    },
    {
      "Sid": "NoObjectDeletionOrLockBypass",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:BypassGovernanceRetention",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": ["arn:aws:s3:::iam-audit-archive", "arn:aws:s3:::iam-audit-archive/*"]
    }
  ]
}
