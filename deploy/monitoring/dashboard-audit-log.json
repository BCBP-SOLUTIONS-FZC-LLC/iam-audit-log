{
  "title": "IAM / Audit Log",
  "uid": "iam-audit-log",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "iam",
    "audit-log",
    "platform-observability"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "description": "iam-audit-log (LLD §11; Enterprise Platform Observability Standard). Generated layout; no panel reads a deprecated metric (TestAlerts_ReferenceKnownMetrics).",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(platform_messages_received_total{domain=\"iam\",service=\"audit-log\"}, environment)",
        "refresh": 2,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "queue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(platform_queue_depth{domain=\"iam\",service=\"audit-log\",environment=\"$environment\"}, queue)",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "event_type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(platform_messages_received_total{domain=\"iam\",service=\"audit-log\",environment=\"$environment\"}, event_type)",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "dependency",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(platform_dependency_request_seconds_count{domain=\"iam\",service=\"audit-log\",environment=\"$environment\"}, dependency)",
        "refresh": 2,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Tier 1 — messaging (platform_*)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Received / processed per second",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rate(platform_messages_received_total{domain=\"iam\", service=\"audit-log\", environment=\"$environment\", queue=~\"$queue\", event_type=~\"$event_type\"}[5m]))",
          "legendFormat": "received {{queue}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(platform_messages_processed_total{domain=\"iam\", service=\"audit-log\", environment=\"$environment\", event_type=~\"$event_type\"}[5m]))",
          "legendFormat": "processed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Failures and retries by reason",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(platform_messages_failed_total{domain=\"iam\", service=\"audit-log\", environment=\"$environment\", event_type=~\"$event_type\"}[5m]))",
          "legendFormat": "failed {{reason}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(platform_retry_total{domain=\"iam\", service=\"audit-log\", environment=\"$environment\", event_type=~\"$event_type\"}[5m]))",
          "legendFormat": "retry {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Failure ratio",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:platform_messages_failure_ratio:5m{domain=\"iam\", service=\"audit-log\", environment=\"$environment\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Duplicates deduplicated (AL-INV-4) and dead-lettered",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(platform_duplicate_messages_total{domain=\"iam\", service=\"audit-log\", environment=\"$environment\", event_type=~\"$event_type\"}[5m]))",
          "legendFormat": "duplicates"
        },
        {
          "refId": "B",
          "expr": "sum by (queue, reason) (rate(platform_dlq_messages_total{domain=\"iam\", service=\"audit-log\", environment=\"$environment\", queue=~\"$queue\"}[5m]))",
          "legendFormat": "dead-lettered {{queue}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      }
    },
    {
      "type": "row",
      "title": "Tier 1 — dependencies",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Dependency latency p99 by dependency/operation",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (dependency, operation, le) (rate(platform_dependency_request_seconds_bucket{domain=\"iam\", service=\"audit-log\", environment=\"$environment\", dependency=~\"$dependency\"}[5m])))",
          "legendFormat": "{{dependency}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "timeseries",
      "title": "Dependency error ratio",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:platform_dependency_request_error_ratio:10m{domain=\"iam\", service=\"audit-log\", environment=\"$environment\"}",
          "legendFormat": "{{dependency}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      }
    },
    {
      "type": "row",
      "title": "Tier 1 — propagation",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Event propagation p50 / p99 (envelope → persisted)",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(platform_event_propagation_seconds_bucket{domain=\"iam\", service=\"audit-log\", environment=\"$environment\", event_type=~\"$event_type\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(platform_event_propagation_seconds_bucket{domain=\"iam\", service=\"audit-log\", environment=\"$environment\", event_type=~\"$event_type\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      }
    },
    {
      "type": "timeseries",
      "title": "Propagation SLO error ratio (budget 1%)",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:audit_log_propagation:error_ratio_5m",
          "legendFormat": "5m"
        },
        {
          "refId": "B",
          "expr": "slo:audit_log_propagation:error_ratio_1h",
          "legendFormat": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      }
    },
    {
      "type": "row",
      "title": "Tier 1 — queues and DLQ",
      "id": 12,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (platform_queue_depth{domain=\"iam\", service=\"audit-log\", environment=\"$environment\", queue=~\"$queue\"})",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      }
    },
    {
      "type": "timeseries",
      "title": "DLQ depth (any > 0 = compliance incident)",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (platform_dlq_depth{domain=\"iam\", service=\"audit-log\", environment=\"$environment\", queue=~\"$queue\"})",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      }
    },
    {
      "type": "row",
      "title": "Tier 3 — ingest and direct-write",
      "id": 15,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Rows ingested by mode",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ingest_mode) (rate(iam_audit_log_events_ingested_total{service=\"audit-log\", environment=\"$environment\"}[5m]))",
          "legendFormat": "{{ingest_mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      }
    },
    {
      "type": "timeseries",
      "title": "Ingest lag p99 (SLO 50 ms)",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(iam_audit_log_ingest_lag_seconds_bucket{service=\"audit-log\", environment=\"$environment\"}[15m])))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      }
    },
    {
      "type": "timeseries",
      "title": "Direct-write outcomes (AL-5/AL-6)",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(iam_audit_log_directwrite_requests_total{service=\"audit-log\", environment=\"$environment\"}[5m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      }
    },
    {
      "type": "timeseries",
      "title": "Unknown event types persisted (AL-EVT-4)",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source_service) (increase(iam_audit_log_unknown_event_total{service=\"audit-log\", environment=\"$environment\"}[1h]))",
          "legendFormat": "{{source_service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      }
    },
    {
      "type": "row",
      "title": "Tier 3 — query and export",
      "id": 20,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 61
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Plan-window clamps by plan",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (plan_code) (rate(iam_audit_log_query_window_clamped_total{service=\"audit-log\", environment=\"$environment\"}[1h]))",
          "legendFormat": "{{plan_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 62
      }
    },
    {
      "type": "timeseries",
      "title": "Archived reads and export lifecycle",
      "id": 22,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(iam_audit_log_query_archived_reads_total{service=\"audit-log\", environment=\"$environment\"}[1h]))",
          "legendFormat": "archived reads"
        },
        {
          "refId": "B",
          "expr": "sum by (status) (rate(iam_audit_log_export_jobs_total{service=\"audit-log\", environment=\"$environment\"}[1h]))",
          "legendFormat": "export {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 62
      }
    },
    {
      "type": "timeseries",
      "title": "API 5xx ratio",
      "id": 23,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:http_requests_error_ratio:5m{job=\"iam-audit-log\"}",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 70
      }
    },
    {
      "type": "row",
      "title": "Tier 3 — archival",
      "id": 24,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 78
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Stalled partitions",
      "id": 25,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(iam_audit_log_archive_stalled_partitions{service=\"audit-log\", environment=\"$environment\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 79
      }
    },
    {
      "type": "stat",
      "title": "Archive lag",
      "id": 26,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(iam_audit_log_archive_lag_seconds{service=\"audit-log\", environment=\"$environment\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 86400
              },
              {
                "color": "red",
                "value": 259200
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 79
      }
    },
    {
      "type": "stat",
      "title": "Rows in DEFAULT partition",
      "id": 27,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(iam_audit_log_default_partition_rows{service=\"audit-log\", environment=\"$environment\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 79
      }
    },
    {
      "type": "stat",
      "title": "Partitions dropped (24h)",
      "id": 28,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(iam_audit_log_retention_pruned_total{service=\"audit-log\", environment=\"$environment\"}[24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 79
      }
    },
    {
      "type": "row",
      "title": "Tier 3 — redaction",
      "id": 29,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 84
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Redaction tasks stuck pending",
      "id": 30,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(iam_audit_log_redaction_pending_tasks{service=\"audit-log\", environment=\"$environment\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 85
      }
    },
    {
      "type": "timeseries",
      "title": "Redaction outcomes",
      "id": 31,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(iam_audit_log_redaction_tasks_total{service=\"audit-log\", environment=\"$environment\"}[1h]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 85
      }
    },
    {
      "type": "row",
      "title": "Tier 3 — catalog poller",
      "id": 32,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 93
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Plan map staleness",
      "id": 33,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
